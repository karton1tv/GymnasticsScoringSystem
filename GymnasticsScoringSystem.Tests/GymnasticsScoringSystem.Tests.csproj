<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <StartupObject></StartupObject>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Для Reqnroll -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

	  <!-- Для Reqnroll: включить генерацию кода -->
	<GenerateSpecFlowCodeBehind>true</GenerateSpecFlowCodeBehind>
	<SpecFlowGenerateTests>true</SpecFlowGenerateTests>

	  <!-- Отключить предупреждения о nullability -->
	  <NoWarn>$(NoWarn);CS8600;CS8602;CS8603;CS8604;CS8618;CS8625</NoWarn>
	  <!-- Отключить предупреждения о неиспользуемых переменных -->
	  <NoWarn>$(NoWarn);CS0168;CS0219;CS0414</NoWarn>
	  <!-- Отключить предупреждения о платформенной совместимости -->
	  <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="FlaUI.Core" Version="4.0.0" />
    <PackageReference Include="FlaUI.UIA3" Version="4.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.1.1" />
    <PackageReference Include="MSTest.TestFramework" Version="3.1.1" />
    <!-- Reqnroll вместо SpecFlow -->
    <PackageReference Include="Reqnroll.MsTest" Version="2.2.0" />
    <PackageReference Include="Reqnroll.Tools.MsBuild.Generation" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GymnasticsScoringSystem.WPF\GymnasticsScoringSystem.WPF.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

</Project>