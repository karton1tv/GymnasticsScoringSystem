<Window x:Class="GymnasticsScoringSystem.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Система судейства - Авторизация" 
        Height="350" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" 
                   Text="Авторизация" 
                   FontSize="20" 
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"
                   AutomationProperties.AutomationId="txtTitle"/>

        <!-- Форма входа -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock Text="Имя пользователя:" 
                       Margin="0,0,0,5"
                       AutomationProperties.AutomationId="lblUsername"/>
            <TextBox x:Name="txtUsername" 
                     Margin="0,0,0,15" 
                     Height="25"
                     AutomationProperties.AutomationId="txtUsername"/>

            <TextBlock Text="Пароль:" 
                       Margin="0,0,0,5"
                       AutomationProperties.AutomationId="lblPassword"/>
            <PasswordBox x:Name="txtPassword" 
                         Margin="0,0,0,15" 
                         Height="25"
                         AutomationProperties.AutomationId="txtPassword"/>

            <Button x:Name="btnLogin" 
                    Content="Войти" 
                    Click="btnLogin_Click"
                    Height="30"
                    Margin="0,0,0,10"
                    AutomationProperties.AutomationId="btnLogin"/>

            <TextBlock x:Name="lblError" 
                       Foreground="Red" 
                       TextWrapping="Wrap"
                       Visibility="Collapsed"
                       AutomationProperties.AutomationId="lblError"/>
        </StackPanel>

        <!-- Кнопка выхода -->
        <Button Grid.Row="2" 
                Content="Выход" 
                Click="btnExit_Click"
                HorizontalAlignment="Right"
                Width="80"
                Height="25"
                AutomationProperties.AutomationId="btnExit"/>
    </Grid>
</Window>